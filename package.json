{
  "name": "dsh-ai-memory",
  "version": "0.1.0",
  "description": "Capture DeepSeek Harness sessions into ai-memory with real session identity.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ai-memory",
    "memory",
    "plugin"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
