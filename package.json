{
  "name": "dsh-ai-memory",
  "version": "0.9.1",
  "description": "Capture DeepSeek Harness sessions into ai-memory with real session identity.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ai-memory",
    "memory",
    "plugin"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "author": "lilianda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1121611810/dsh-ai-memory.git"
  },
  "homepage": "https://github.com/a1121611810/dsh-ai-memory#readme",
  "bugs": {
    "url": "https://github.com/a1121611810/dsh-ai-memory/issues"
  }
}
